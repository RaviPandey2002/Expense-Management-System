# ─── Server ───────────────────────────────────────────────────────────────────

# Port the Express server listens on
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas or local)
# Atlas example:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local example:  mongodb://localhost:27017/expense-management
MONGO_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/expense-management

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens — must be long, random, and kept private
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────

# URL of the frontend (used to whitelist CORS origin)
# Development:  http://localhost:3000
# Production:   https://your-deployed-frontend.com
CLIENT_URL=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────────

# Set to "production" in prod — enables secure cookies
NODE_ENV=development
